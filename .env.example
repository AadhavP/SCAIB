# ============================================================
# agent-evals environment configuration
# Copy to `.env` and fill in values:  cp .env.example .env
# The application loads `.env` from the working directory and also
# accepts these as real environment variables (e.g. in Docker).
# Never commit the real `.env`.
# ============================================================

# --- Primary test config: GLM 5.2 via OpenRouter ---
# Create an API key at https://openrouter.ai/keys (starts with sk-or-v1-).
LLM_MODEL=z-ai/glm-5.2
LLM_API_KEY=sk-or-v1-your-openrouter-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Alternative: direct provider keys (used by the `providers` extra) ---
# Only needed if you bypass OpenRouter and call a provider directly.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=

# --- Application settings (AGENT_EVALS_ prefix) ---
# Nested settings use "__" as the delimiter, e.g. AGENT_EVALS_API__PORT.
AGENT_EVALS_APP_NAME=agent-evals
AGENT_EVALS_ENVIRONMENT=development
AGENT_EVALS_DEBUG=true
AGENT_EVALS_LOG_LEVEL=INFO
AGENT_EVALS_LOG_JSON=false

# API server. Use 0.0.0.0 when running inside Docker/containers.
AGENT_EVALS_API__HOST=0.0.0.0
AGENT_EVALS_API__PORT=8000
AGENT_EVALS_API__WORKERS=1
# Development executes jobs in-process. Production should set this to false and
# run the dedicated `agent-evals worker` service against the same durable store.
AGENT_EVALS_API__EXECUTE_JOBS_IN_PROCESS=true
# Bearer token required on all /v1 routes (except /v1/health and /v1/ready).
# Optional only when AGENT_EVALS_ENVIRONMENT is development/testing/local;
# production-like startup refuses to boot until this is set.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The frontend never sees this value: docker-compose passes it to the reverse
# proxy (nginx in prod, the Vite dev proxy otherwise), which attaches it as
# `Authorization: Bearer ...` on proxied /v1 requests. Do not add a VITE_
# prefixed copy -- that would inline the key into the public browser bundle,
# and a browser EventSource cannot send the header itself anyway.
# AGENT_EVALS_API__API_KEY=
# Private/loopback agent URLs are disabled by default to prevent SSRF. Enable
# only for trusted local integration tests.
AGENT_EVALS_API__ALLOW_PRIVATE_AGENT_ENDPOINTS=false
# List-valued settings are JSON-encoded (pydantic-settings).
AGENT_EVALS_API__CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:8000"]

# Storage directories (mounted as volumes in docker-compose).
AGENT_EVALS_STORAGE__DATA_DIR=./data
AGENT_EVALS_STORAGE__REPORTS_DIR=./reports_output
AGENT_EVALS_STORAGE__CACHE_DIR=./.cache
# Durable job and SSE event control-plane state. Mount the parent directory on
# persistent storage in production.
AGENT_EVALS_STORAGE__JOB_DB_PATH=./data/evaluation_jobs.sqlite3

# Sandbox execution defaults.
AGENT_EVALS_SANDBOX__TIMEOUT_SECONDS=300
AGENT_EVALS_SANDBOX__MAX_MEMORY_GB=16
