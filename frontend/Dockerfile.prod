# Production image: build static assets, serve them via nginx.
# The nginx config proxies /v1 to the API service on the compose network and
# attaches the API bearer token server-side, so no credential is bundled into
# the JavaScript delivered to the browser.

FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
# The base image runs every executable in this directory before starting nginx.
COPY docker-entrypoint.d/10-api-auth.sh /docker-entrypoint.d/10-api-auth.sh
RUN chmod +x /docker-entrypoint.d/10-api-auth.sh
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/ || exit 1
